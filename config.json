{
  "station": {
    "id": "lab_station_01",
    "name": "CUA Lab Pi"
  },
  "app": {
    "pollIntervalSeconds": 10,
    "barrelDepthCm": 137.16,
    "apiUrl": "http://54.213.147.59:5000/sensor"
  },
  "adaptive": {
    "enabled": true,
    "idleFactor": 10,
    "rainProbabilityThreshold": 0,
    "lookaheadHours": 24
  },
  "weather": {
    "intervalSeconds": 1800,
    "source": "openmeteo",
    "latitude": 38.98,
    "longitude": -77.10,
    "noaaOffice": "LWX",
    "noaaGridX": 97,
    "noaaGridY": 71
  },
  "adc": {
    "chip": "/dev/gpiochip0",
    "wrPin": 2,
    "psPin": 27,
    "clockPin": 4,
    "powerPin": -1,
    "wrHighUs": 500000,
    "conversionDelayMs": 500,
    "pulseWidthUs": 50000,
    "settleUs": 50000,
    "cacheMs": 2000
  },
  "sensors": [
    {
      "type": "distance",
      "id": "hcsr04_depth",
      "unit": "in",
      "name": "Inflow Weir Head",
      "intervalSeconds": 5,
      "samplesPerReading": 10,
      "params": {
        "chip": "/dev/gpiochip0",
        "trigPin": 17,
        "echoPin": 18,
        "totalLength": 48
      }
    },
    {
      "type": "maxbotix",
      "id": "maxbotix_depth",
      "unit": "in",
      "name": "Ponding Depth",
      "intervalSeconds": 5,
      "samplesPerReading": 10,
      "params": {
        "device": "/dev/serial0",
        "totalLength": 48
      }
    },
    {
      "id": "moisture_sensor",
      "type": "moisture",
      "unit": "%",
      "name": "Soil Moisture",
      "intervalSeconds": 60,
      "samplesPerReading": 1,
      "params": {
        "dataPin": 5,
        "adcDry": 105,
        "adcWet": 32
      }
    }
  ]
}
