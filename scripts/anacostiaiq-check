#!/usr/bin/env bash
set -u

# AnacostiaIQ deployment diagnostic.
# Read-only checks: this script does not switch modes, restart services,
# change GPIO/UART configuration, or modify application state.

REPO_DIR="${ANACOSTIAIQ_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/anacostiaiq"
MODE_FILE="$STATE_DIR/mode"
LOCK_FILE="$STATE_DIR/hardware.lock"
QUEUE_FILE="$STATE_DIR/upload-queue.jsonl"
SERVICE="anacostiaiqd.service"

PASS=0
WARN=0
FAIL=0

line()  { printf '%-10s %-30s %s\n' "$1" "$2" "$3"; }
pass()  { PASS=$((PASS+1)); line '[PASS]' "$1" "${2:-}"; }
warn()  { WARN=$((WARN+1)); line '[WARN]' "$1" "${2:-}"; }
fail()  { FAIL=$((FAIL+1)); line '[FAIL]' "$1" "${2:-}"; }
info()  { line '[INFO]' "$1" "${2:-}"; }
section() {
    printf '\n%s\n' "$1"
    printf '%s\n' "$2"
}

read_mode() {
    if [[ -r "$MODE_FILE" ]]; then
        tr -d '[:space:]' < "$MODE_FILE"
    else
        printf '%s' missing
    fi
}

service_state() {
    systemctl --user is-active "$SERVICE" 2>/dev/null || true
}

service_enabled() {
    systemctl --user is-enabled "$SERVICE" 2>/dev/null || true
}

printf '\n%s\n' '============================================================'
printf '%s\n' ' AnacostiaIQ System Check'
printf '%s\n\n' '============================================================'

section 'Runtime' '-------'
MODE="$(read_mode)"
case "$MODE" in
    gui|headless) pass 'Saved mode' "$MODE" ;;
    missing)      fail 'Saved mode' "missing: $MODE_FILE" ;;
    *)            fail 'Saved mode' "invalid: $MODE" ;;
esac

GUI_PID="$(pgrep -x AnacostiaIQ 2>/dev/null | paste -sd, - || true)"
HEADLESS_PID="$(pgrep -x anacostiaiqd 2>/dev/null | paste -sd, - || true)"
SERVICE_STATE="$(service_state)"

if [[ "$MODE" == gui ]]; then
    if [[ -n "$GUI_PID" ]]; then
        pass 'GUI process' "running (PID $GUI_PID)"
    elif [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        fail 'GUI process' 'not running in graphical session'
    else
        warn 'GUI process' 'not visible in this shell/session'
    fi

    if [[ -z "$HEADLESS_PID" && "$SERVICE_STATE" != active ]]; then
        pass 'Headless daemon' 'correctly inactive in GUI mode'
    else
        fail 'Headless daemon' "unexpectedly running (service=$SERVICE_STATE pid=${HEADLESS_PID:-none})"
    fi
elif [[ "$MODE" == headless ]]; then
    if [[ -n "$HEADLESS_PID" && "$SERVICE_STATE" == active ]]; then
        pass 'Headless daemon' "running (PID $HEADLESS_PID)"
    else
        fail 'Headless daemon' "not running (service=$SERVICE_STATE pid=${HEADLESS_PID:-none})"
    fi

    if [[ -z "$GUI_PID" ]]; then
        pass 'GUI process' 'correctly inactive in headless mode'
    else
        fail 'GUI process' "unexpectedly running (PID $GUI_PID)"
    fi
else
    info 'GUI process' "${GUI_PID:-not running}"
    info 'Headless process' "${HEADLESS_PID:-not running}"
fi

if [[ -f "$LOCK_FILE" ]]; then
    pass 'Hardware lock' "$LOCK_FILE"
else
    if [[ -n "$GUI_PID" || -n "$HEADLESS_PID" ]]; then
        fail 'Hardware lock' 'missing while application is running'
    else
        warn 'Hardware lock' 'not present; no application process detected'
    fi
fi

section 'Startup recovery' '----------------'
if [[ -f "$HOME/.config/systemd/user/$SERVICE" ]]; then
    pass 'User service' 'installed'
else
    fail 'User service' 'not installed'
fi

ENABLED="$(service_enabled)"
if [[ "$ENABLED" == enabled ]]; then
    pass 'User service' 'enabled'
else
    fail 'User service' "not enabled ($ENABLED)"
fi

if command -v loginctl >/dev/null 2>&1; then
    LINGER="$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || true)"
    if [[ "$LINGER" == yes ]]; then
        pass 'User lingering' 'enabled'
    else
        warn 'User lingering' "${LINGER:-unknown}"
    fi
else
    warn 'User lingering' 'loginctl unavailable'
fi

if systemctl is-active --quiet display-manager.service 2>/dev/null; then
    pass 'Display manager' 'active'
else
    if [[ "$MODE" == gui ]]; then
        warn 'Display manager' 'inactive; GUI restore needs a graphical login'
    else
        info 'Display manager' 'inactive'
    fi
fi

if [[ -f "$HOME/.config/autostart/anacostiaiq-gui.desktop" ]]; then
    pass 'GUI autostart' 'installed'
else
    warn 'GUI autostart' 'not installed'
fi

section 'Hardware / interfaces' '---------------------'
if [[ -L /dev/serial0 || -e /dev/serial0 ]]; then
    SERIAL_TARGET="$(readlink -f /dev/serial0 2>/dev/null || printf '/dev/serial0')"
    pass '/dev/serial0' "$SERIAL_TARGET"

    SERIAL_UNIT="serial-getty@$(basename "$SERIAL_TARGET").service"
    SERIAL_GETTY_STATE="$(systemctl is-active "$SERIAL_UNIT" 2>/dev/null || true)"
    SERIAL_GETTY_ENABLED="$(systemctl is-enabled "$SERIAL_UNIT" 2>/dev/null || true)"
    if [[ "$SERIAL_GETTY_STATE" == active ]]; then
        fail 'Serial getty' "$SERIAL_UNIT active (enabled=$SERIAL_GETTY_ENABLED)"
    else
        pass 'Serial getty' "inactive (enabled=$SERIAL_GETTY_ENABLED)"
    fi
else
    warn '/dev/serial0' 'not present'
fi

if [[ -r /proc/device-tree/model ]]; then
    MODEL="$(tr -d '\000' < /proc/device-tree/model)"
    info 'Device' "$MODEL"
fi

section 'Cloud queue' '-----------'
if [[ -e "$QUEUE_FILE" ]]; then
    if [[ -r "$QUEUE_FILE" && -w "$QUEUE_FILE" ]]; then
        pass 'Upload queue' 'readable/writable'
    elif [[ -r "$QUEUE_FILE" ]]; then
        warn 'Upload queue' 'readable but not writable'
    else
        fail 'Upload queue' 'not readable'
    fi
    PENDING="$(grep -cve '^[[:space:]]*$' "$QUEUE_FILE" 2>/dev/null || true)"
    info 'Pending uploads' "${PENDING:-0}"
else
    pass 'Upload queue' 'empty (queue file not created yet)'
    info 'Pending uploads' '0'
fi

section 'Recent sensor/recovery evidence' '-------------------------------'
LOG_SOURCE=''
if [[ "$MODE" == gui && -r /tmp/anacostiaiq-gui.log ]]; then
    LOG_SOURCE=/tmp/anacostiaiq-gui.log
fi

if [[ -n "$LOG_SOURCE" ]]; then
    RECENT="$(tail -n 250 "$LOG_SOURCE" 2>/dev/null || true)"
    if grep -q 'scheduling recovery\|Recovery attempt\|recovery' <<<"$RECENT"; then
        pass 'Sensor recovery' 'recovery activity seen in recent GUI log'
    else
        info 'Sensor recovery' 'no recent recovery message'
    fi

    if grep -q 'DistanceSensor: timeout\|HC-SR04 Depth: no valid reading' <<<"$RECENT"; then
        warn 'HC-SR04' 'recent reading warnings'
    else
        info 'HC-SR04' 'no recent warning in GUI log'
    fi

    if grep -q 'MaxbotixSensor: no valid frame\|MB7389-100 Depth: no valid reading' <<<"$RECENT"; then
        warn 'MB7389' 'recent reading warnings'
    else
        info 'MB7389' 'no recent warning in GUI log'
    fi
else
    info 'Sensor logs' 'run mode-specific logs for detailed sensor status'
fi

section 'Repository' '----------'
if [[ -d "$REPO_DIR/.git" ]] && command -v git >/dev/null 2>&1; then
    BRANCH="$(git -C "$REPO_DIR" branch --show-current 2>/dev/null || true)"
    SHA="$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || true)"
    TRACKED_DIRTY="$(git -C "$REPO_DIR" status --porcelain --untracked-files=no 2>/dev/null || true)"
    UNTRACKED_COUNT="$(git -C "$REPO_DIR" ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d '[:space:]')"
    info 'Git revision' "${BRANCH:-detached} ${SHA:-unknown}"
    if [[ -z "$TRACKED_DIRTY" ]]; then
        pass 'Tracked source tree' 'clean'
    else
        warn 'Tracked source tree' 'tracked local changes present'
    fi
    if [[ "${UNTRACKED_COUNT:-0}" -gt 0 ]]; then
        info 'Untracked build files' "$UNTRACKED_COUNT present (not treated as source changes)"
    else
        info 'Untracked build files' '0'
    fi
else
    warn 'Repository' "$REPO_DIR is not a Git checkout"
fi

printf '\n%s\n' '============================================================'
printf ' PASS: %d   WARN: %d   FAIL: %d\n' "$PASS" "$WARN" "$FAIL"
if (( FAIL > 0 )); then
    printf '%s\n' ' Overall: FAIL'
    RESULT=2
elif (( WARN > 0 )); then
    printf '%s\n' ' Overall: PASS WITH WARNINGS'
    RESULT=1
else
    printf '%s\n' ' Overall: PASS'
    RESULT=0
fi
printf '%s\n\n' '============================================================'

exit "$RESULT"
