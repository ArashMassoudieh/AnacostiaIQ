# AnacostiaIQ health email alert configuration
# Copy to ~/.config/anacostiaiq/health-email.env on the machine running the
# monitor. Keep the real file private (chmod 600) and NEVER commit passwords.

# Alarm monitoring: field station only by default.
ANACOSTIAIQ_EMAIL_ALERTS_ENABLED=false
ANACOSTIAIQ_API_URL=http://54.213.147.59:5000
ANACOSTIAIQ_ALERT_STATION_ID=field_station_01
ANACOSTIAIQ_ALERT_STATION_NAME="John McCormack Field Station"
ANACOSTIAIQ_ALERT_STATION_LOCATION="John McCormack Rd NE · Washington, DC"
ANACOSTIAIQ_ALERT_POLL_SECONDS=60
ANACOSTIAIQ_APPLICATION_STALE_SECONDS=600
ANACOSTIAIQ_ALERT_LOOKBACK_HOURS=24
# Zero disables reminders. Set, for example, 21600 for one reminder every six
# hours while a component remains degraded, offline, or critical.
ANACOSTIAIQ_ALERT_REPEAT_SECONDS=0

# Optional comma-separated override. Defaults to all health components.
# ANACOSTIAIQ_ALERT_COMPONENTS=application,overall,cloud,upload_queue,storage,cpu_temperature,sensor_hcsr04_depth,sensor_maxbotix_depth,sensor_moisture_sensor

# Email recipients may be comma-separated.
ANACOSTIAIQ_EMAIL_FROM=anacostiaiq@example.org
ANACOSTIAIQ_EMAIL_TO=recipient@example.org

# Generic SMTP settings. Example values below suit STARTTLS providers using
# port 587; adapt host/user/password to the account actually selected.
ANACOSTIAIQ_SMTP_HOST=smtp.example.org
ANACOSTIAIQ_SMTP_PORT=587
ANACOSTIAIQ_SMTP_STARTTLS=true
ANACOSTIAIQ_SMTP_SSL=false
ANACOSTIAIQ_SMTP_USERNAME=anacostiaiq@example.org
ANACOSTIAIQ_SMTP_PASSWORD=replace-with-app-password-or-smtp-token
