#!/usr/bin/env bash
set -euo pipefail

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
HEALTH_FILE="$STATE_HOME/anacostiaiq/health.json"

if [[ ! -f "$HEALTH_FILE" ]]; then
  echo "AnacostiaIQ health snapshot not found: $HEALTH_FILE" >&2
  echo "Start the headless monitor first; it creates this file automatically." >&2
  exit 2
fi

if command -v jq >/dev/null 2>&1; then
  jq -r '
    "AnacostiaIQ health @ " + (.timestamp // "unknown"),
    "",
    (.components | to_entries[] |
      (.key | gsub("_"; " ")) as $name |
      ($name + "\t" + ((.value.status // "unknown") | ascii_upcase) + "\t" + (.value.reason // "")))
  ' "$HEALTH_FILE" | column -t -s $'\t' 2>/dev/null || cat "$HEALTH_FILE"
else
  cat "$HEALTH_FILE"
fi
