{
  "_comment": "Sensor Dashboard configuration. Physical and derived series are both declared here; derived expressions are evaluated in the viewer and are never fetched from the API.",
  "api_url": "http://54.213.147.59:5000",
  "window_title": "AnacostiaIQ — Sensor Dashboard",
  "refresh_interval_sec": 60,
  "auto_refresh": false,
  "scrollable_charts": false,
  "default_range": { "days_back": 7, "days_ahead": 7 },
  "sensors": [
    {
      "id": "hcsr04_depth",
      "name": "Inflow Weir Head",
      "unit": "in",
      "color": "#26c6da",
      "area_color": "#2826c6da",
      "floor_at_zero": false
    },
    {
      "id": "inflow_rate",
      "type": "derived",
      "name": "Inflow Rate",
      "unit": "L/s",
      "color": "#66BB6A",
      "area_color": "#2866BB6A",
      "floor_at_zero": true,
      "visible": false,
      "_calibration_note": "Enable after the weir drawing/calibration supplies the actual crest_offset_in, cd and angle_deg. The numbers below are Arash's illustrative example only and must not be treated as field calibration.",
      "inputs": { "d": "hcsr04_depth" },
      "params": {
        "crest_offset_in": 12.0,
        "in_to_m": 0.0254,
        "cd": 0.58,
        "angle_deg": 90.0,
        "g": 9.80665,
        "m3s_to_ls": 1000.0
      },
      "let": { "h": "(crest_offset_in - d) * in_to_m" },
      "expression": "(8/15)*cd*sqrt(2*g)*tan(angle_deg*pi/360)*pow(h,2.5)*m3s_to_ls",
      "valid_when": "h >= 0.02"
    },
    {
      "id": "maxbotix_depth",
      "name": "Ponding Depth",
      "unit": "in",
      "color": "#26a69a",
      "area_color": "#2826a69a",
      "floor_at_zero": false
    },
    {
      "id": "moisture_sensor",
      "name": "Soil Moisture",
      "unit": "%",
      "color": "#8d6e63",
      "area_color": "#2d8d6e63",
      "floor_at_zero": true
    },
    {
      "id": "temperature",
      "name": "Temperature",
      "unit": "°C",
      "color": "#ef5350",
      "area_color": "#40ef5350",
      "floor_at_zero": false
    },
    {
      "id": "precip_amount",
      "name": "Precipitation Amount",
      "unit": "mm",
      "color": "#42a5f5",
      "area_color": "#2d42a5f5",
      "floor_at_zero": true
    },
    {
      "id": "precip_prob",
      "name": "Precipitation Probability",
      "unit": "%",
      "color": "#ab47bc",
      "area_color": "#28ab47bc",
      "floor_at_zero": true
    }
  ]
}
