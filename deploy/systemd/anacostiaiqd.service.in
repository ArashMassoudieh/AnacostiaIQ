[Unit]
Description=AnacostiaIQ Headless Sensor Monitor

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
ExecCondition=/bin/bash @REPO_DIR@/scripts/anacostiaiq-mode is-headless
ExecStart=@REPO_DIR@/headless/anacostiaiqd --config @REPO_DIR@/config.json
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
